# Public URL of the site (no trailing slash). Used for OAuth + Stripe redirects.
BASE_URL=http://localhost:3000
PORT=3000

# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Optional but recommended: webhook secret for POST /stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
PRICE_CENTS=1000

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: ${BASE_URL}/auth/google/callback
# Enable the Google Drive API. Scope used: drive.file (app can only touch files/folders it creates).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random chars. Encrypts Drive refresh tokens at rest and signs nothing else.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
